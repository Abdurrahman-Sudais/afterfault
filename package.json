{
  "name": "afterfault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/render.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/cases.test.js src/app/engine.test.js src/app/workflow.test.js",
    "test:ui": "node scripts/ui-check.mjs",
    "assets": "node scripts/export-assets.mjs",
    "preview:file": "node scripts/standalone.mjs",
    "test:artifacts": "node scripts/artifact-check.mjs",
    "test:prototype": "node scripts/prototype-check.mjs",
    "test:backend": "python3 backend/tests/test_lambdas.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  }
}
