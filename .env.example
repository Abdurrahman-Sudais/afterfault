# No environment variables required for this browser-only review version.
# Never put secret keys in public VITE_ variables.

# Optional: send the early-access form to HubSpot instead of opening an email draft.
# Portal and form IDs are public identifiers, not secrets. See docs/crm-plan.md.
# VITE_HUBSPOT_PORTAL_ID=
# VITE_HUBSPOT_FORM_GUID=
# VITE_HUBSPOT_MARKETING_SUBSCRIPTION_ID=
